<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RuleSim</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(WrathComboRulesSrc)\RuleExpressions.cs" Link="Linked\RuleExpressions.cs" />
    <Compile Include="$(WrathComboRulesSrc)\RuleSet.cs" Link="Linked\RuleSet.cs" />
    <None Include="*_symbols.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="action_cat.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RaidReplayDir)\RaidReplay.Core\RaidReplay.Core.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
